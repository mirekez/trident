// Available variables:
//   $(ToolsPath)    - build-local tools directory, normally build/tools/build-current
//   $(BinDir)       - backend launch/binary working directory; GUI push folder is $(BinDir)/.push
//   $(ProjectPath)  - current Trident project directory
//   $(ProjectName)  - current Trident project archive name without .trident suffix
//   $(CSourceList)  - shell-quoted C/C++ source and header files under the project
//   $(SVSourceList) - shell-quoted Verilog/SystemVerilog files under the project
//   ${TopModuleName} - top module name from project options
//   $(TopModuleFile) - top module source file from project options
//   $(MainTestFile)  - main test source file from project options
//   $(AdditionalSources) - additional source files from project options
//   $(JsonOutputPath) - optional schematics JSON output path requested by Schematics tabs
{
  "actions": {
    "Run": {
      "command": [
        "CONDA_ROOT=\"$(BinDir)/.conda\"",
        "if [ ! -d \"$CONDA_ROOT\" ]; then",
        "  CONDA_ROOT=\"$(BinDir)/../.conda\"",
        "fi",
        "CONDA_ROOT=\"$(cd \"$CONDA_ROOT\" && pwd -P)\"",
        "RUN_DIR=\".trident/run\"",
        "RUN_EXE=\"$RUN_DIR/trident_run\"",
        "mkdir -p \"$RUN_DIR\"",
        "export PATH=\"$CONDA_ROOT/bin:$PATH\"",
        "RUN_SOURCES=()",
        "add_run_source() {",
        "  case \"$1\" in",
        "    *.c|*.cc|*.cpp|*.cxx)",
        "      for existing in \"${RUN_SOURCES[@]}\"; do",
        "        if [ \"$existing\" = \"$1\" ]; then",
        "          return",
        "        fi",
        "      done",
        "      RUN_SOURCES+=(\"$1\")",
        "      ;;",
        "  esac",
        "}",
        "add_run_source \"$(MainTestFile)\"",
        "add_run_source \"$(TopModuleFile)\"",
        "for source in $(AdditionalSources); do",
        "  add_run_source \"$source\"",
        "done",
        "if [ ${#RUN_SOURCES[@]} -eq 0 ]; then",
        "  echo \"Run failed: no C/C++ source files selected.\"",
        "  exit 1",
        "fi",
        "\"$CONDA_ROOT/bin/clang++\" \\",
        "  -std=c++26 \\",
        "  -I\"$(ToolsPath)/cpphdl/include\" \\",
        "  -I. \\",
        "  -I.. \\",
        "  \"${RUN_SOURCES[@]}\" \\",
        "  -o \"$RUN_EXE\"",
        "COMPILE_STATUS=$?",
        "if [ $COMPILE_STATUS -ne 0 ]; then",
        "  exit $COMPILE_STATUS",
        "fi",
        "RUN_ARGS=()",
        "case \"$(ProjectPath)/$(MainTestFile)\" in",
        "  */tools/cpphdl/examples/*) RUN_ARGS+=(\"--noveril\") ;;",
        "esac",
        "\"$RUN_EXE\" \"${RUN_ARGS[@]}\"",
        "RUN_STATUS=$?",
        "if [ $RUN_STATUS -ne 0 ]; then",
        "  exit $RUN_STATUS",
        "fi",
        "if [ -n \"$(JsonOutputPath)\" ]; then",
        "  GCC_VERSION=\"$(ls -1 \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu\" | sort -V | tail -1)\"",
        "  CPPHDL_INCLUDE_ROOT=\".trident/cpphdl_include\"",
        "  mkdir -p .trident",
        "  rm -rf \"$CPPHDL_INCLUDE_ROOT\"",
        "  mkdir -p \"$CPPHDL_INCLUDE_ROOT\"",
        "  cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/x86_64-conda-linux-gnu/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  cp -as --update=none \"$CONDA_ROOT/lib/clang/21/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  cp -as --update=none \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  cp -as --update=none \"$CONDA_ROOT/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  cp -as --update=none \"$(ToolsPath)/cpphdl/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "  ln -sfn ../linux \"$CPPHDL_INCLUDE_ROOT/bits/linux\"",
        "  CPPHDL_BIN=\"$(ToolsPath)/cpphdl/cpphdl\"",
        "  if [ ! -x \"$CPPHDL_BIN\" ] && [ -x \"$(BinDir)/../tools/cpphdl/build/cpphdl\" ]; then",
        "    CPPHDL_BIN=\"$(BinDir)/../tools/cpphdl/build/cpphdl\"",
        "  fi",
        "  if [ ! -x \"$CPPHDL_BIN\" ]; then",
        "    echo \"Run schematics failed: cpphdl executable not found: $CPPHDL_BIN\"",
        "    exit 127",
        "  fi",
        "  TOP_MODULE_FILE=\"$(TopModuleFile)\"",
        "  if [ -z \"$TOP_MODULE_FILE\" ]; then",
        "    TOP_MODULE_FILE=\"${TopModuleName}.cpp\"",
        "  fi",
        "  TEST_SCHEMATICS_FILE=\"$(MainTestFile)\"",
        "  case \"$TEST_SCHEMATICS_FILE\" in",
        "    *.c|*.cc|*.cpp|*.cxx)",
        "      TEST_HEADER=\"${TEST_SCHEMATICS_FILE%.*}.h\"",
        "      if [ -f \"$TEST_HEADER\" ]; then",
        "        TEST_SCHEMATICS_FILE=\"$TEST_HEADER\"",
        "      fi",
        "      ;;",
        "  esac",
        "  if [ -z \"$TEST_SCHEMATICS_FILE\" ]; then",
        "    TEST_SCHEMATICS_FILE=\"$TOP_MODULE_FILE\"",
        "  fi",
        "  \"$CPPHDL_BIN\" \"$TEST_SCHEMATICS_FILE\" \\",
        "    --generated-dir \".trident/schematics_generated\" \\",
        "    --json-output \"$(JsonOutputPath)\" \\",
        "    --no-synthesis-flag \\",
        "    -nostdinc \\",
        "    -D_GLIBCXX_USE_TBB_PAR_BACKEND=0 \\",
        "    -isystem \"$(ToolsPath)/cpphdl/include\" \\",
        "    -isystem \"$PWD/$CPPHDL_INCLUDE_ROOT\" \\",
        "    -isystem \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include\" \\",
        "    -isystem \"$CONDA_ROOT/lib/clang/21/include\" \\",
        "    -iquote . \\",
        "    --sysroot=\"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot\"",
        "fi"
      ]
    },
    "Compile": {
      "command": [
        "CONDA_ROOT=\"$(BinDir)/.conda\"",
        "if [ ! -d \"$CONDA_ROOT\" ]; then",
        "  CONDA_ROOT=\"$(BinDir)/../.conda\"",
        "fi",
        "CONDA_ROOT=\"$(cd \"$CONDA_ROOT\" && pwd -P)\"",
        "GCC_VERSION=\"$(ls -1 \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu\" | sort -V | tail -1)\"",
        "CPPHDL_INCLUDE_ROOT=\".trident/cpphdl_include\"",
        "mkdir -p .trident",
        "rm -rf \"$CPPHDL_INCLUDE_ROOT\"",
        "mkdir -p \"$CPPHDL_INCLUDE_ROOT\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/x86_64-conda-linux-gnu/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/clang/21/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$(ToolsPath)/cpphdl/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "ln -sfn ../linux \"$CPPHDL_INCLUDE_ROOT/bits/linux\"",
        "unset CONDA_PREFIX",
        "export PATH=\"$CONDA_ROOT/bin:$PATH\"",
        "CPPHDL_BIN=\"$(ToolsPath)/cpphdl/cpphdl\"",
        "if [ ! -x \"$CPPHDL_BIN\" ] && [ -x \"$(BinDir)/../tools/cpphdl/build/cpphdl\" ]; then",
        "  CPPHDL_BIN=\"$(BinDir)/../tools/cpphdl/build/cpphdl\"",
        "fi",
        "if [ ! -x \"$CPPHDL_BIN\" ]; then",
        "  echo \"Compile failed: cpphdl executable not found: $CPPHDL_BIN\"",
        "  exit 127",
        "fi",
        "TOP_MODULE_FILE=\"$(TopModuleFile)\"",
        "if [ -z \"$TOP_MODULE_FILE\" ]; then",
        "  TOP_MODULE_FILE=\"${TopModuleName}.cpp\"",
        "fi",
        "JSON_OUTPUT_PATH=\"$(JsonOutputPath)\"",
        "if [ -z \"$JSON_OUTPUT_PATH\" ]; then",
        "  JSON_OUTPUT_PATH=\"design.json\"",
        "fi",
        "\"$CPPHDL_BIN\" \"$TOP_MODULE_FILE\" $(AdditionalSources) \\",
        "  --json-output \"$JSON_OUTPUT_PATH\" \\",
        "  -nostdinc \\",
        "  -D_GLIBCXX_USE_TBB_PAR_BACKEND=0 \\",
        "  -DSYNTHESIS \\",
        "  -isystem \"$(ToolsPath)/cpphdl/include\" \\",
        "  -isystem \"$PWD/$CPPHDL_INCLUDE_ROOT\" \\",
        "  -isystem \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include\" \\",
        "  -isystem \"$CONDA_ROOT/lib/clang/21/include\" \\",
        "  -iquote . \\",
        "  --sysroot=\"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot\""
      ]
    },
    "Synthesis": {
      "command": [
        "CONDA_ROOT=\"$(BinDir)/.conda\"",
        "if [ ! -d \"$CONDA_ROOT\" ]; then",
        "  CONDA_ROOT=\"$(BinDir)/../.conda\"",
        "fi",
        "CONDA_ROOT=\"$(cd \"$CONDA_ROOT\" && pwd -P)\"",
        "GCC_VERSION=\"$(ls -1 \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu\" | sort -V | tail -1)\"",
        "CPPHDL_INCLUDE_ROOT=\".trident/cpphdl_include\"",
        "mkdir -p .trident generated",
        "rm -rf \"$CPPHDL_INCLUDE_ROOT\"",
        "mkdir -p \"$CPPHDL_INCLUDE_ROOT\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/x86_64-conda-linux-gnu/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/clang/21/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$(ToolsPath)/cpphdl/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "ln -sfn ../linux \"$CPPHDL_INCLUDE_ROOT/bits/linux\"",
        "unset CONDA_PREFIX",
        "export PATH=\"$CONDA_ROOT/bin:$PATH\"",
        "CPPHDL_BIN=\"$(ToolsPath)/cpphdl/cpphdl\"",
        "if [ ! -x \"$CPPHDL_BIN\" ] && [ -x \"$(BinDir)/../tools/cpphdl/build/cpphdl\" ]; then",
        "  CPPHDL_BIN=\"$(BinDir)/../tools/cpphdl/build/cpphdl\"",
        "fi",
        "if [ ! -x \"$CPPHDL_BIN\" ]; then",
        "  echo \"Synthesis failed: cpphdl executable not found: $CPPHDL_BIN\"",
        "  exit 127",
        "fi",
        "TOP_MODULE_FILE=\"$(TopModuleFile)\"",
        "if [ -z \"$TOP_MODULE_FILE\" ]; then",
        "  TOP_MODULE_FILE=\"${TopModuleName}.cpp\"",
        "fi",
        "SYNTH_STAMP=\".trident/synthesis_start\"",
        ": > \"$SYNTH_STAMP\"",
        "\"$CPPHDL_BIN\" \"$TOP_MODULE_FILE\" $(AdditionalSources) \\",
        "  --json-output design.json \\",
        "  -nostdinc \\",
        "  -D_GLIBCXX_USE_TBB_PAR_BACKEND=0 \\",
        "  -DSYNTHESIS \\",
        "  -isystem \"$(ToolsPath)/cpphdl/include\" \\",
        "  -isystem \"$PWD/$CPPHDL_INCLUDE_ROOT\" \\",
        "  -isystem \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include\" \\",
        "  -isystem \"$CONDA_ROOT/lib/clang/21/include\" \\",
        "  -iquote . \\",
        "  --sysroot=\"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot\"",
        "SYNTH_SV_FILES=\"$(find generated -maxdepth 1 -type f -name '*.sv' -newer \"$SYNTH_STAMP\" | sort | tr '\\n' ' ')\"",
        "if [ -z \"$SYNTH_SV_FILES\" ]; then",
        "  echo \"Synthesis failed: cpphdl generated no SystemVerilog files.\"",
        "  exit 1",
        "fi",
        "\"$(ToolsPath)/yosys/yosys\" \\",
        "  -m \"$(ToolsPath)/yosys/share/plugins/slang.so\" \\",
        "  -p \"read_slang --best-effort-hierarchy -top ${TopModuleName} $SYNTH_SV_FILES; hierarchy -check -top ${TopModuleName}; proc; opt_expr; opt_clean; memory -nomap; opt_clean; write_json output.json\""
      ]
    },
    "Synthesize": {
      "command": [
        "CONDA_ROOT=\"$(BinDir)/.conda\"",
        "if [ ! -d \"$CONDA_ROOT\" ]; then",
        "  CONDA_ROOT=\"$(BinDir)/../.conda\"",
        "fi",
        "CONDA_ROOT=\"$(cd \"$CONDA_ROOT\" && pwd -P)\"",
        "GCC_VERSION=\"$(ls -1 \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu\" | sort -V | tail -1)\"",
        "CPPHDL_INCLUDE_ROOT=\".trident/cpphdl_include\"",
        "mkdir -p .trident generated",
        "rm -rf \"$CPPHDL_INCLUDE_ROOT\"",
        "mkdir -p \"$CPPHDL_INCLUDE_ROOT\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/c++/x86_64-conda-linux-gnu/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/gcc/x86_64-conda-linux-gnu/$GCC_VERSION/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/lib/clang/21/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$CONDA_ROOT/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "cp -as --update=none \"$(ToolsPath)/cpphdl/include/.\" \"$CPPHDL_INCLUDE_ROOT/\"",
        "ln -sfn ../linux \"$CPPHDL_INCLUDE_ROOT/bits/linux\"",
        "unset CONDA_PREFIX",
        "export PATH=\"$CONDA_ROOT/bin:$PATH\"",
        "CPPHDL_BIN=\"$(ToolsPath)/cpphdl/cpphdl\"",
        "if [ ! -x \"$CPPHDL_BIN\" ] && [ -x \"$(BinDir)/../tools/cpphdl/build/cpphdl\" ]; then",
        "  CPPHDL_BIN=\"$(BinDir)/../tools/cpphdl/build/cpphdl\"",
        "fi",
        "if [ ! -x \"$CPPHDL_BIN\" ]; then",
        "  echo \"Synthesis failed: cpphdl executable not found: $CPPHDL_BIN\"",
        "  exit 127",
        "fi",
        "TOP_MODULE_FILE=\"$(TopModuleFile)\"",
        "if [ -z \"$TOP_MODULE_FILE\" ]; then",
        "  TOP_MODULE_FILE=\"${TopModuleName}.cpp\"",
        "fi",
        "SYNTH_STAMP=\".trident/synthesis_start\"",
        ": > \"$SYNTH_STAMP\"",
        "\"$CPPHDL_BIN\" \"$TOP_MODULE_FILE\" $(AdditionalSources) \\",
        "  --json-output design.json \\",
        "  -nostdinc \\",
        "  -D_GLIBCXX_USE_TBB_PAR_BACKEND=0 \\",
        "  -DSYNTHESIS \\",
        "  -isystem \"$(ToolsPath)/cpphdl/include\" \\",
        "  -isystem \"$PWD/$CPPHDL_INCLUDE_ROOT\" \\",
        "  -isystem \"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot/usr/include\" \\",
        "  -isystem \"$CONDA_ROOT/lib/clang/21/include\" \\",
        "  -iquote . \\",
        "  --sysroot=\"$CONDA_ROOT/x86_64-conda-linux-gnu/sysroot\"",
        "SYNTH_SV_FILES=\"$(find generated -maxdepth 1 -type f -name '*.sv' -newer \"$SYNTH_STAMP\" | sort | tr '\\n' ' ')\"",
        "if [ -z \"$SYNTH_SV_FILES\" ]; then",
        "  echo \"Synthesis failed: cpphdl generated no SystemVerilog files.\"",
        "  exit 1",
        "fi",
        "\"$(ToolsPath)/yosys/yosys\" \\",
        "  -m \"$(ToolsPath)/yosys/share/plugins/slang.so\" \\",
        "  -p \"read_slang --best-effort-hierarchy -top ${TopModuleName} $SYNTH_SV_FILES; hierarchy -check -top ${TopModuleName}; proc; opt_expr; opt_clean; memory -nomap; opt_clean; write_json output.json\""
      ]
    },
    "Build": {
      "command": "echo \"Build project: $(ProjectPath)\"; echo \"Tools: $(ToolsPath)\"; echo \"C/C++ sources: $(CSourceList)\"; echo \"Verilog/SystemVerilog sources: $(SVSourceList)\""
    }
  }
}
